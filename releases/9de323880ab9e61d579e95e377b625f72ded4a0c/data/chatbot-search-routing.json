      "method": "GET",
      "endpoint_template": "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi?db=pmc&term={query}&retmode=json&retmax={limit}",
      "query_encoding": "url_component_utf8",
      "allowed_hosts": [
        "eutils.ncbi.nlm.nih.gov"
