      "target_source_policy": "same_as_provider",
      "result_identity_fields": [
        "entry.id"
      ],
      "oa_result_rule": "records_are_open_repository_items_but_peer_review_and_version_of_record_must_not_be_inferred",
      "dedupe_key_order": [
        "entry.id",
        "normalized_title_year"
