      "adapter_id": "doaj-article-topic-search",
      "source_id": "doaj",
      "status": "searchable",
      "capability": "topic_search",
      "method": "GET",
      "endpoint_template": "https://doaj.org/api/v4/search/articles/{query}?page=1&pageSize={limit}",
