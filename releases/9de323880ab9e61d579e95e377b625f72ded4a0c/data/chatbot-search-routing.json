      "adapter_id": "arxiv-topic-search",
      "source_id": "arxiv",
      "status": "searchable",
      "capability": "topic_search",
      "method": "GET",
      "endpoint_template": "https://export.arxiv.org/api/query?search_query=all%3A{query}&start=0&max_results={limit}",
