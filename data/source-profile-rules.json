{"schema_version":"0.2.0","updated":"2026-08-16","method":"deterministic_source_use_profile_v2","scale":{"min":0,"max":4,"note_en":"Ordinal source-level routing heuristic. Scores describe how to use a source, not article quality, journal prestige, validity, or truth.","note_zh-TW":"來源層級的序位式用途路由；描述來源怎麼用，不代表單篇文章品質、期刊聲望、有效性或真偽。"},"derived_fields":["source_type","subjects","oa_scope","peer_review_scope","publication_state","access_roles","machine_access","status","verification","access_policy","parent_id","notes"],"dimensions":{"academic_rigor":{"en":"Strength of source-level formal review/publication controls.","zh-TW":"來源層級正式審查與出版控制的強度。"},"frontier_velocity":{"en":"How early the source tends to expose research relative to formal publication.","zh-TW":"相對正式出版而言，來源能多早暴露研究訊號。"},"signal_density":{"en":"Proxy for expected filtering density from review status and specialization; not an empirical acceptance-rate metric.","zh-TW":"依審查狀態與專門程度推估的訊號密度代理值；不是實測接受率。"},"machine_readability":{"en":"Availability of structured formats and verified feed/API/OAI/bulk endpoints.","zh-TW":"結構化格式與已驗證 feed／API／OAI／bulk 端點的可用程度。"},"version_clarity":{"en":"How clearly the source separates preprints, accepted manuscripts, versions of record, registry records, or review material.","zh-TW":"來源對預印本、作者接受稿、正式版本、註冊紀錄與審查材料的版本界線是否清楚。"},"oa_reliability":{"en":"How consistently the registered source scope is openly accessible.","zh-TW":"登錄範圍內公開存取狀態的一致與可靠程度。"},"specialization":{"en":"How narrowly the source is focused on a field or research community.","zh-TW":"來源對特定學科或研究社群的專門程度。"},"noise_risk":{"en":"Caution level for unreviewed, mixed-state, or broad early-stage material. Higher means more filtering is needed.","zh-TW":"未審查、混合狀態或大流量早期材料的雜訊警戒；越高越需要額外篩選。"}},"tiers":{"R1":{"en":"formal-core","zh-TW":"正式核心","description_en":"Peer-reviewed formal publication source with clear VOR role.","description_zh-TW":"具同儕審查、正式出版且正式版本角色清楚的核心來源。"},"R2":{"en":"strong-formal","zh-TW":"強正式來源","description_en":"Formal or openly reviewed publication source useful for evidence, with some scope/version/state caveat.","description_zh-TW":"可作正式或公開審查證據來源，但仍有範圍、版本或審查狀態限制。"},"F1":{"en":"frontier-primary","zh-TW":"前沿主力","description_en":"Active, verified early-research source suited to frontier discovery.","description_zh-TW":"活躍且已驗證，適合追前沿早期研究的主力來源。"},"F2":{"en":"frontier-exploratory","zh-TW":"前沿探索","description_en":"Useful early signal with higher uncertainty, community scope, partial verification, or inactive submission status.","description_zh-TW":"具有早期訊號價值，但社群範圍、不確定性、驗證限制或停止收稿等條件較多。"},"D1":{"en":"discovery-infrastructure","zh-TW":"發現／查證基礎設施","description_en":"Best used to discover, register, connect, or verify evidence rather than treated as the research result itself.","description_zh-TW":"主要用來發現、註冊、連結或查證證據，不應把平台本身當成研究結果。"},"A1":{"en":"archive-backbone","zh-TW":"典藏骨架","description_en":"Repository/archive infrastructure valuable for durable access, backfiles, data, theses or version recovery.","description_zh-TW":"適合長期存取、資料／學位論文典藏、回溯與版本回復的基礎設施。"}},"archetypes":{"formal_anchor":{"en":"formal anchor","zh-TW":"正式證據錨點"},"frontier_scout":{"en":"frontier scout","zh-TW":"前沿偵察兵"},"specialist_hunter":{"en":"specialist hunter","zh-TW":"專門領域獵犬"},"broad_firehose":{"en":"broad firehose","zh-TW":"高流量廣域來源","description_en":"High-volume broad source where filtering matters.","description_zh-TW":"資料量大且領域廣，若不篩選容易被大量訊號淹沒。"},"version_bridge":{"en":"version bridge","zh-TW":"版本橋接器"},"archive_backbone":{"en":"archive backbone","zh-TW":"典藏骨架"},"methods_workshop":{"en":"methods workshop","zh-TW":"方法工作坊"},"heterodox_frontier":{"en":"heterodox frontier","zh-TW":"非主流前沿"},"policy_signal":{"en":"policy signal","zh-TW":"政策訊號站"},"clinical_early_warning":{"en":"clinical early warning","zh-TW":"臨床早期警報"},"discovery_infrastructure":{"en":"discovery infrastructure","zh-TW":"發現基礎設施"},"review_observatory":{"en":"review observatory","zh-TW":"審查觀測站"},"community_hub":{"en":"community hub","zh-TW":"社群前沿樞紐"},"cross_disciplinary_hub":